# Copia este archivo a .env y pone los valores reales.
# El .env NO se commitea; este .env.example si, para que se sepa que hace falta.

# --- Django ---------------------------------------------------------------
# Generala con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiala-por-una-de-verdad

# 1 solo en tu maquina. En Railway va en 0 (o directamente no se define).
DEBUG=1

# El dominio donde vive el sitio, sin https://
DOMINIO=www.dacars.com.co

# Si hay mas de un dominio, separados por coma. Railway suma el suyo solo.
# ALLOWED_HOSTS=www.dacars.com.co,dacars.com.co

# --- Base de datos --------------------------------------------------------
# En Railway lo inyecta el plugin de Postgres. En local, sin esto, usa SQLite.
# DATABASE_URL=postgresql://usuario:clave@host:5432/railway

# --- Cloudinary -----------------------------------------------------------
# Las fotos de producto que suba el comercio van aca.
# Se saca de https://console.cloudinary.com -> Settings -> API Keys
# Sin esta variable, las fotos se guardan en media/ (sirve para desarrollar).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Primer usuario del panel ---------------------------------------------
# Solo para el arranque en Railway, donde la base no es alcanzable desde
# afuera y no se puede correr createsuperuser contra ella.
#
# Se definen las dos, Railway redespliega, y el usuario queda creado.
# DESPUES SE BORRA ADMIN_CLAVE: mientras siga ahi, cada despliegue vuelve a
# escribir esa contrasena y pisa cualquier cambio hecho desde el panel.
# ADMIN_USUARIO=dacars
# ADMIN_CLAVE=
# ADMIN_EMAIL=

# --- Negocio --------------------------------------------------------------
# El numero de WhatsApp, con indicativo y sin signos.
WHATSAPP=573112629406
