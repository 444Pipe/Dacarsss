{% load static %}{
  "name": "DACARS — Personalización de vehículos en Villavicencio",
  "short_name": "DACARS",
  "description": "Lujos, accesorios 4x4, PPF, detailing y polarizados en Villavicencio, Meta.",
  "lang": "es-CO",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
